coverage/
.env
.env.local
/deploy/
multi_run/
# The per-worktree setup.conf override. base self-uses the docker
# namespace it ships, so a base checkout can carry one too, and it must
# never be committed -- an untracked layer that got committed would
# silently become everyone's config.
.setup.conf.local
# Wrapper transcripts (#606/#609). base runs its own wrappers during the
# test suite, which writes transcripts under log/ (any depth, e.g.
# script/docker/log/). The canonical .gitignore sync targets consumer
# repos, not base itself, so ignore them here directly.
log/
# Released trees materialised by script/test/prepare-prev-release.sh for
# the released-caller compatibility spec. Derived from this repo's own tags
# (never hand-written), regenerated on demand, and deliberately parked at
# the repo root rather than under test/: every lint driver scans a fixed
# root list, and an old release inside one of those roots would be linted
# as if it were current source.
.prev-release/
*.swp
*.swo
.DS_Store
.vscode/
.idea/

# Claude Code session state when launched inside this sub-repo.
# Workspace-level Claude config lives in ycpss91255-docker/claude-workspace.
.claude
CLAUDE.md
test/bats/.shard-weights
