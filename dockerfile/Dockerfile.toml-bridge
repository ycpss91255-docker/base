# Dockerfile.toml-bridge -- containerised TOML parser (ADR-37).
#
# Reads TOML from stdin, writes JSON to stdout. The host contract is
# Docker + Git + just; this image keeps it that way by running the parser
# inside a container rather than requiring host-side Python.
#
# NOT built by hand in the normal case. dist/script/docker/lib/toml_bridge.sh
# provisions this image before the first TOML read, under a tag that is a
# content digest of this file and everything it COPYs, so a consumer's
# `just setup` builds it once per revision of the bridge and never pulls a
# floating tag. The header there says why.
#
# THE BUILD CONTEXT IS THIS DIRECTORY, not the repo root, which is what
# makes the shipped copy buildable from a consumer: the subtree prefix is
# the consumer's to name (`.base` by convention, nothing more), so a COPY
# path reaching up through it could not be written here at all.
#
#   docker build -t toml-bridge:local -f dockerfile/Dockerfile.toml-bridge \
#     dockerfile
#   printf '[gui]\nmode = "wayland"\n' | docker run --rm -i toml-bridge:local
#
# Dockerfile.test-tools carries the same parser so the self-test suite
# gets it without building this image, but it does NOT consume this one:
# its context IS the repo root, so it COPYs `dockerfile/toml_bridge.py`
# out of it and installs alpine's python3 to run it under. It used to say
# `COPY --from` here, and that described the file rather than the
# capability -- the final stage had no interpreter at all. The two differ
# only in the runtime: this image pins Python 3.13 and vendors tomli so
# the bridge also works on the 3.6-3.10 hosts the backport exists for.

# tool-pin: toml-bridge-python dockerhub library/python pattern=^3\.13\.[0-9]+-alpine3\.22$
ARG PYTHON_VERSION=3.13.13-alpine3.22
FROM python:${PYTHON_VERSION}

# Vendored tomli: the backport of stdlib tomllib (PEP 680), MIT-licensed,
# ~1000 lines, zero transitive dependencies. Python 3.11+ uses the stdlib
# tomllib; tomli is the fallback for older runtimes (3.6+). Both are
# installed so the bridge script works on any Python >= 3.6 without
# conditional pip logic.
# tool-pin: tomli github-release hukkin/tomli
ARG TOMLI_VERSION=2.4.1
RUN pip install --no-cache-dir "tomli==${TOMLI_VERSION}"

COPY toml_bridge.py /usr/local/bin/toml-bridge
RUN chmod +x /usr/local/bin/toml-bridge

ENTRYPOINT ["python3", "/usr/local/bin/toml-bridge"]
