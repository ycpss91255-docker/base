# Dockerfile.config-gen -- build, gate and ship the config generator
# (ADR-00000039, base#1462).
#
# THE BUILD CONTEXT IS dockerfile/config-gen, the Go module itself:
#
#   docker build --progress=plain --no-cache-filter admit,test --target test \
#     -f dockerfile/Dockerfile.config-gen dockerfile/config-gen
#
# Nobody runs that by hand in the normal case. script/test/config_gen_gates.sh
# (the runner `just test go` calls, in every environment) runs it, then
# builds `final` and holds the binary to its usage contract.
#
# Stages:
#   tools        golangci-lint and gremlins, each downloaded at a pinned
#                version and checksum
#   placeholder  the sentinel file the mutation stage copies
#   mutation     FROM scratch: a sentinel file alone. The runner replaces this
#                stage with `--build-context mutation=<dir>` (the host
#                mutation baseline, base#1464); a build that was not given
#                that context sees the sentinel instead (base#1465).
#   goenv        the pinned Go image with GOTOOLCHAIN=local and bash; the
#                base of admit, build and test
#   admit        no Go: refuses a build that got no mutation context, printing
#                `cg_event config_gen_manifest_missing` on stderr, which the
#                runner re-emits as that event; refuses a context holding
#                no admit.sh (the 01-admit step did not run) as
#                `cg_event config_gen_manifest_stale file=admit.sh
#                reason=absent`; then runs the context's
#                admit.sh (script/test/config_gen_admit.sh, beside the
#                producer's constructor library) over the module, which
#                refuses a file changed after the baseline was written, or
#                a baseline the producer cannot write for the module, with
#                `cg_event config_gen_manifest_stale file=... reason=...`
#                and `config_gen_gate_admission_failed`; otherwise prints
#                `gate=admission ok`. The test stage starts by copying its
#                /admitted, so no gate runs before it passed.
#   build        the module and its static binary (cmd/config-gen only;
#                cmd/cg-gates and internal/buildgate are built in test and
#                never reach final)
#   test         FROM goenv, not FROM build: a --target test build must run
#                no go before admit passed (base#1465), and build's go build
#                would otherwise run beside admit. Then the five gates, one
#                RUN each, in this order: fmt, vet, lint, race, coverage
#                (measured counts, then cg-gates ratchet against
#                coverage-floors.d and the mutation context's floors.base). A
#                gate that passes prints `gate=<g> ok`; one that fails prints
#                `config_gen_gate_<g>_failed` on stderr and stops the build.
#                Each is its own RUN so a red names its gate and the gates
#                after it read as never reached, not as passed. The id is
#                spelled from ${g} in the RUN text, so BuildKit's echo of the
#                RUN line itself never carries a literal id the runner would
#                read as a failure. After coverage, the ignored-input gate
#                (base#1467) refuses a Git-ignored module file left in the
#                build context, then the corpus sensitivity
#                gate (base#1467) flips each golden file for the packages
#                handed it, then the mutation gate (base#1467) runs gremlins
#                on each package the change manifest maps to; they print
#                per-golden and per-package lines and no ok line yet.
#   final        FROM scratch: the binary alone, which is what ships.
#
# The race gate needs cgo and gcc, which the trixie golang image carries
# and the alpine one does not.

# tool-pin: golang dockerhub library/golang pattern=^1\.[0-9]+\.[0-9]+-trixie$
ARG GO_IMAGE=golang:1.27.2-trixie@sha256:47667934874913a449b96faa7ef4777fa285d9ec29126ee80ed61c45b7cccf0e

FROM ${GO_IMAGE} AS tools
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
# tool-pin: golangci-lint github-release golangci/golangci-lint
ARG GOLANGCI_LINT_VERSION=v2.15.0
# The release's own checksums file, per architecture. A bump of the
# version above must bump both.
ARG GOLANGCI_LINT_SHA256_AMD64=9b7fe6a6bf6334b98decf8d86b11415ea7889afdabdd1959fdce23af2a9ebcea
ARG GOLANGCI_LINT_SHA256_ARM64=b4d8f17068b35ee6060cc2f69a16fb48740d706fbba81661c318649c114a6998
# arch-literal-lint: allow-begin -- the TARGETARCH-to-checksum mapping is
# the one place the architecture names meet: golangci-lint publishes one
# checksum per linux-<arch> asset, and the asset name itself is built from
# ${TARGETARCH}. TARGETARCH is auto-populated by BuildKit; it carries no
# default, which would shadow that (moby/buildkit#3403).
ARG TARGETARCH
RUN case "${TARGETARCH}" in \
      amd64) sum="${GOLANGCI_LINT_SHA256_AMD64}" ;; \
      arm64) sum="${GOLANGCI_LINT_SHA256_ARM64}" ;; \
      *) echo "no golangci-lint checksum for TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    name="golangci-lint-${GOLANGCI_LINT_VERSION#v}-linux-${TARGETARCH}"; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 3 -o /tmp/golangci-lint.tar.gz \
      "https://github.com/golangci/golangci-lint/releases/download/${GOLANGCI_LINT_VERSION}/${name}.tar.gz"; \
    echo "${sum}  /tmp/golangci-lint.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/golangci-lint.tar.gz -C /tmp; \
    install -m 0755 "/tmp/${name}/golangci-lint" /usr/local/bin/golangci-lint; \
    rm -rf /tmp/golangci-lint.tar.gz "/tmp/${name}"
# tool-pin: gremlins github-release go-gremlins/gremlins
ARG GREMLINS_VERSION=v0.6.0
# The release's own checksums.txt, per architecture. A bump of the
# version above must bump both.
ARG GREMLINS_SHA256_AMD64=b02a42e47935f891c9a411d68c07e211c7082609e79c2435b67c85ee9658c538
ARG GREMLINS_SHA256_ARM64=686542674e54559afb7e86d6994d342c19a856cfd970c315748989537936664c
RUN case "${TARGETARCH}" in \
      amd64) sum="${GREMLINS_SHA256_AMD64}" ;; \
      arm64) sum="${GREMLINS_SHA256_ARM64}" ;; \
      *) echo "no gremlins checksum for TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    name="gremlins_${GREMLINS_VERSION#v}_linux_${TARGETARCH}"; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 3 -o /tmp/gremlins.tar.gz \
      "https://github.com/go-gremlins/gremlins/releases/download/${GREMLINS_VERSION}/${name}.tar.gz"; \
    echo "${sum}  /tmp/gremlins.tar.gz" | sha256sum -c -; \
    mkdir /tmp/gremlins; \
    tar -xzf /tmp/gremlins.tar.gz -C /tmp/gremlins; \
    install -m 0755 /tmp/gremlins/gremlins /usr/local/bin/gremlins; \
    rm -rf /tmp/gremlins.tar.gz /tmp/gremlins
# arch-literal-lint: allow-end

# The sentinel's name is the placeholder's whole contract: admit refuses
# the build when it finds it under /mutation. It is made in a stage and
# copied, not written by a COPY heredoc: config_gen_resolve's tag
# derivation refuses a heredoc COPY source as unresolvable.
FROM ${GO_IMAGE} AS placeholder
RUN touch /no-mutation-context

FROM scratch AS mutation
COPY --from=placeholder /no-mutation-context /no-mutation-context

FROM ${GO_IMAGE} AS goenv
# ADR-00000039 lists GOTOOLCHAIN=local among the build flags: the pinned
# image's toolchain or nothing, never one go fetches for a go.mod asking
# for a newer Go. The golang image pinned today already sets it; this keeps
# it set when GO_IMAGE is overridden or bumped to an image that does not.
# admit, build and test are FROM goenv, so every go command inherits it.
# It sits above SHELL because placed below it, hadolint reported SC3010
# ([[ in POSIX sh) on the test stage's fmt RUN.
ENV GOTOOLCHAIN=local
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
WORKDIR /src

FROM goenv AS admit
# The id is spelled from ${e} in the RUN text, as the gate ids are, so
# BuildKit's echo of the RUN line never carries the literal id.
# The checker is the host's (the 01-admit step put it in the mutation
# context); the module is only bound for it to read, never built here.
RUN --mount=type=bind,from=mutation,target=/mutation \
    --mount=type=bind,target=/src \
    e=manifest_missing; s=manifest_stale; g=admission; \
    if [[ -e /mutation/no-mutation-context ]]; then echo "cg_event config_gen_${e}" >&2; exit 1; fi; \
    if [[ ! -f /mutation/admit.sh ]]; then echo "cg_event config_gen_${s} file=admit.sh reason=absent"; echo "config_gen_gate_${g}_failed" >&2; exit 1; fi; \
    bash /mutation/admit.sh /mutation /src || { echo "config_gen_gate_${g}_failed" >&2; exit 1; }; \
    echo gate=admission ok; \
    touch /admitted

FROM goenv AS build
COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags=-s -o /out/config-gen ./cmd/config-gen

# The gates. The runner builds this stage with --no-cache-filter admit,test,
# so admit's RUN and every RUN below execute on every run, two unchanged
# runs in a row included (base#1465): a cached RUN prints nothing, and
# the ok lines would then report cache state rather than a gate. The Go
# build cache is mounted only to save compile time; it is keyed on content.
FROM goenv AS test
COPY --from=admit /admitted /admitted
COPY --from=tools /usr/local/bin/golangci-lint /usr/local/bin/golangci-lint
COPY --from=tools /usr/local/bin/gremlins /usr/local/bin/gremlins
COPY . .
# gofmt exits non-zero on a file it cannot parse (a _test.go syntax error
# passes the build stage); that status must name this gate too, not end
# the RUN under set -e before the id is printed.
RUN g=fmt; out="$(gofmt -l .)" || { echo "config_gen_gate_${g}_failed" >&2; exit 1; }; \
    if [[ -n "${out}" ]]; then printf 'gofmt -l: %s\n' "${out}" >&2; echo "config_gen_gate_${g}_failed" >&2; exit 1; fi; \
    echo gate=fmt ok
RUN --mount=type=cache,target=/root/.cache/go-build \
    g=vet; go vet ./... || { echo "config_gen_gate_${g}_failed" >&2; exit 1; }; \
    echo gate=vet ok
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/root/.cache/golangci-lint \
    g=lint; golangci-lint run ./... || { echo "config_gen_gate_${g}_failed" >&2; exit 1; }; \
    echo gate=lint ok
# -count=1: a race is a property of one execution, so a cached pass must
# not stand in for running the tests under the detector. This also runs
# every Fuzz* seed corpus.
# The shared corpus is moved out of the module to a fresh temp directory
# before the tests run, and only internal/testcorpus is told where it went
# (-ldflags -X sets its unexported root). A test that reads testdata by any
# other path finds nothing there and fails this gate (base#1468). The root
# is also written to /tmp/config-gen-corpus-root for the later RUNs.
RUN --mount=type=cache,target=/root/.cache/go-build \
    g=race; { tc="$(go list -m)/internal/testcorpus" && r="$(mktemp -d)" && mv testdata "${r}/" \
      && printf '%s.root=%s\n' "${tc}" "${r}/testdata" >/tmp/config-gen-corpus-root \
      && CGO_ENABLED=1 go test -race -count=1 -ldflags="-X=$(cat /tmp/config-gen-corpus-root)" ./...; } \
      || { echo "config_gen_gate_${g}_failed" >&2; exit 1; }; \
    echo gate=race ok
# The coverage gate: coverage.sh, which 01-admit installed from the host
# checkout's script/test/config_gen_coverage.sh into the mutation context
# (outside the module the mutation gate maps, base#1467), measures every
# package's counts,
# then cg-gates ratchet (built here, never shipped) judges them against
# the coverage-floors.d fragments and the base's floors, floors.base, which
# the 05-floors-base step wrote into the mutation context. The context is
# bound, not copied, so the ratchet reads the floors.base admission's
# context carried (base#1465). Each part prints its own refusal lines;
# the id is spelled from ${g} so BuildKit's echo of the RUN carries none.
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=bind,from=mutation,target=/mutation \
    g=coverage; { bash /mutation/coverage.sh --measure /tmp/measured /tmp/config-gen-corpus-root \
      && go build -o /tmp/cg-gates ./cmd/cg-gates \
      && /tmp/cg-gates ratchet --measured /tmp/measured --floors coverage-floors.d \
        --base /mutation/floors.base --module "$(go list -m)"; } \
      || { echo "config_gen_gate_${g}_failed" >&2; exit 1; }; \
    echo gate=coverage ok
# The ignored-input gate (base#1467): cg-gates ignored, built by the
# coverage RUN, refuses a build context holding a file the producer listed
# in the mutation context's ignored.sha256, a Git-ignored module file
# nothing tests. The context is bound, not read from /src: the race RUN
# moved testdata/ out of it. Like the mutation gate it prints no ok line.
RUN --mount=type=bind,from=mutation,target=/mutation \
    --mount=type=bind,target=/ctx \
    g=ignored; /tmp/cg-gates ignored --list /mutation/ignored.sha256 --context /ctx \
      || { echo "config_gen_gate_${g}_failed" >&2; exit 1; }
# The corpus sensitivity gate (base#1467): cg-gates sensitivity, built by
# the coverage RUN, runs each package whose tests depend on
# internal/testcorpus once with a traced Glob against the corpus root the
# race RUN wrote, then flips the first byte of each golden file in a copy
# of that root and fails when a package its tests were handed that golden
# by still passes. Like the mutation gate it prints no ok line.
RUN --mount=type=cache,target=/root/.cache/go-build \
    g=corpus_sensitivity; { w="$(mktemp -d)" && r="$(cat /tmp/config-gen-corpus-root)" \
      && /tmp/cg-gates sensitivity --module "$(go list -m)" --root "${r#*=}" --work "${w}"; } \
      || { echo "config_gen_gate_${g}_failed" >&2; exit 1; }
# The mutation gate (base#1467): cg-gates mutation, built by the coverage
# RUN, runs gremlins on each package the change manifest in the mutation
# context maps to. A package fails when gremlins exits non-zero, whatever
# its report holds; after an exit of 0 it fails below 90.0 efficacy,
# counted from the report's KILLED, LIVED and TIMED OUT mutants rather than
# the efficacy figure gremlins writes. GOFLAGS hands every go test gremlins
# runs the corpus root the race RUN wrote, as -X tells internal/testcorpus
# there. It prints no ok line: the runner's green callers expect exactly
# the six gates above.
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=bind,from=mutation,target=/mutation \
    g=mutation; { r="$(mktemp -d)" \
      && GOFLAGS="-ldflags=-X=$(cat /tmp/config-gen-corpus-root)" \
        /tmp/cg-gates mutation --manifest /mutation/manifest --module "$(go list -m)" --reports "${r}"; } \
      || { echo "config_gen_gate_${g}_failed" >&2; exit 1; }

FROM scratch AS final
COPY --from=build /out/config-gen /config-gen
ENTRYPOINT ["/config-gen"]
