# base self-release / publish tooling (`just release <recipe>`). SKELETON.
#
# ADR-00000010 lays this namespace as part of the base/downstream split
# (test and release are kept as separate namespaces, not a merged one);
# ADR-00000011 renames it `cd` -> `release` (action-named). The actual
# release / publish pipeline recipes are deferred to a follow-up issue;
# today the release flow still lives in .github/workflows/ (self-test.yaml
# `release` job + release-worker.yaml).
#
# `set working-directory` mirrors script/test/justfile.test so future recipes
# run from the repo root whether reached via the `release` module or `just -f`.
set working-directory := '../..'

# source_file (not justfile) is this module's own file: inside a mod?'d
# module justfile resolves to the ROOT entry, so listing it would show the
# entry's namespaces instead of the release recipes. source_file
# pins --list to THIS module.
# Default: list available recipes
default:
    @just --justfile '{{source_file()}}' --list

# just release coverage-badge -> regenerate doc/badge/coverage.svg, the
# per-release coverage figure the README draws (ADR-00000008, per-release
# figure amendment).
#
# The release BUMP runs this; it is not a step anyone performs by hand and
# not something to run per merge. The figure refreshes ONCE PER RELEASE and
# rides the `chore: release vX.Y.Z` commit alongside `.version` and the
# CHANGELOG promotion, so the badge, the tag and the changelog entry are the
# same commit or none of them are.
#
# It reads the kcov reports under coverage/, so run `just test coverage` on
# the commit being released first. It REFUSES -- writing nothing, leaving
# the previous badge in place -- when there is no report, when a report
# predates the commit, or when instrumented sources are modified in the
# worktree: a release whose coverage never ran must not publish a stale or
# an invented number.
#
# `just release coverage-badge --unmeasured` renders "not measured" for the
# current .version. That is for a version that genuinely has no measurement;
# the bump never passes it.
coverage-badge *args:
    ./script/release/coverage_badge.sh {{args}}
