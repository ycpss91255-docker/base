#!/usr/bin/env bats
#
# conf_abnormal_input_spec.bats -- abnormal setup.toml input, driven through
# the shell seam (`setup apply`, `_conf_load_layers`) rather than the bridge
# alone (base#1400).
#
# why: The bridge's own specs prove what the parser does with a file; they
# cannot prove what an operator gets. Between the two sit the shell reader,
# the merge, the emitters and the writeback, and each of them can turn an
# input the parser handled into a different .env, a partial output, or a
# configuration silently replaced by the template defaults. So each case
# here starts from a setup.toml on disk and ends at what `apply` wrote or
# refused -- CRLF line endings, a non-ASCII value, invalid UTF-8, a 1 MiB
# value, an unreadable layer, and a directory where the layer should be.

bats_require_minimum_version 1.5.0

setup() {
  load "${BATS_TEST_DIRNAME}/test_helper"
  TEMP_DIR="$(mktemp -d)"
  REPO="${TEMP_DIR}/repo"
  mkdir -p "${REPO}"
  CONF="${REPO}/setup.toml"
  LIB=/source/dist/script/docker/lib
  SETUP_SH=/source/dist/script/docker/wrapper/setup.sh
}

teardown() {
  chmod -R u+rwX "${TEMP_DIR}" 2>/dev/null || true
  rm -rf "${TEMP_DIR}"
}

# The files one `setup apply` generates into the repo.
_GENERATED_SET=(.env .env.generated compose.yaml)

# _apply [<repo>]
#   `setup apply` on <repo> (default ${REPO}) with JSON logging, stdout and
#   stderr captured apart.
_apply() {
  local _repo="${1:-${REPO}}"
  run --separate-stderr bash -c "
    export LOG_FORMAT=json
    source '${SETUP_SH}'
    main apply --base-path '${_repo}'
  "
}

# _rows <file>
#   The rows `_conf_load_layers` loads from <file>, one
#   `<section>\t<key>\t<value>` per line, in load order.
_rows() {
  run --separate-stderr bash -c "
    export LOG_FORMAT=json
    source '${LIB}/conf.sh'
    _conf_load_layers H '${1}' || exit
    for (( i = 0; i < \${#H__keys[@]}; i++ )); do
      printf '%s\t%s\t%s\n' \"\${H__es[i]}\" \"\${H__keys[i]}\" \"\${H__vals[i]}\"
    done
  "
}

# _generated_view <dir>
#   The generated set of <dir> -- .env, .env.generated, compose.yaml --
#   without the three lines that differ between two runs by construction:
#   the generation timestamp, SETUP_TIMESTAMP, and SETUP_CONF_HASH (a
#   digest of the setup.toml BYTES, which is the drift detector doing its
#   job when the bytes differ).
_generated_view() {
  local _f
  for _f in "${_GENERATED_SET[@]}"; do
    printf '== %s\n' "${_f}"
    grep -vE '^# Auto-generated by setup\.sh on |^SETUP_TIMESTAMP=|^SETUP_CONF_HASH=' \
      "${1}/${_f}"
  done
}

# _assert_nothing_generated [<dir>]
#   No part of the generated set was written into <dir> (default ${REPO}).
_assert_nothing_generated() {
  local _dir="${1:-${REPO}}" _f
  for _f in "${_GENERATED_SET[@]}"; do
    assert [ ! -e "${_dir}/${_f}" ]
  done
}

# _clear_generated
#   Remove the generated set from ${REPO}, so the next apply writes it anew.
_clear_generated() {
  local _f
  for _f in "${_GENERATED_SET[@]}"; do
    rm -f "${REPO}/${_f}"
  done
}

# why: A file saved on Windows ends every line in CRLF. TOML allows it,
# and the configuration it describes is the same one -- so the shell
# reader must load the same rows and apply must generate the same set,
# with no `\r` carried into a value.
@test "CRLF line endings load the same rows and generate the same set as LF" {
  local _lf='[network]\nmode = "host"\n\n[environment]\nenv_1 = "GREETING=hello"\n'
  printf "${_lf}" > "${CONF}"
  _rows "${CONF}"
  assert_success
  local _lf_rows="${output}"
  assert_line $'environment\tenv_1\tGREETING=hello'
  _apply
  assert_success
  local _lf_view
  _lf_view="$(_generated_view "${REPO}")"
  _clear_generated

  printf "${_lf//\\n/\\r\\n}" > "${CONF}"
  run grep -c $'\r$' "${CONF}"
  assert_output "5"
  _rows "${CONF}"
  assert_success
  assert_equal "${output}" "${_lf_rows}"
  _apply
  assert_success
  assert_equal "$(_generated_view "${REPO}")" "${_lf_view}"
  run grep -c $'\r' "${REPO}/.env" "${REPO}/.env.generated" "${REPO}/compose.yaml"
  refute_output --regexp ':[1-9]'
}

# why: A value outside ASCII is a value like any other: it must reach the
# container env (.env) and the compose file byte for byte -- not escaped,
# not transliterated, not dropped.
@test "a non-ASCII value reaches .env and compose.yaml unchanged" {
  cat > "${CONF}" <<'EOF'
[environment]
env_1 = "GREETING=café☕日本"

[[volumes]]
source = "${WS_PATH}"
target = "/home/${USER_NAME}/work"

[[volumes]]
source = "/srv/café"
target = "/mnt/日本"
EOF
  _apply
  assert_success
  # .env single-quotes every value: the quotes are the emitter's, the
  # bytes between them are the operator's.
  run grep -cxF "GREETING='café☕日本'" "${REPO}/.env"
  assert_output "1"
  run grep -cF "/srv/café:/mnt/日本" "${REPO}/compose.yaml"
  assert_output "1"
}

# why: Bytes that are not UTF-8 are not TOML, so the layer cannot be read.
# The refusal must name the file, and nothing of the generated set may be
# written -- a half-written set reads as a successful apply.
@test "invalid UTF-8 is refused with the file named and nothing generated" {
  # toml-fixture-lint: allow bytes that are not UTF-8 are not TOML; the refusal IS the assertion
  printf '[environment]\nenv_1 = "GREETING=\xff\xfe"\n' > "${CONF}"
  _apply
  assert_refusal 1 conf_toml_merge_failed "${CONF}"
  _assert_nothing_generated
}

# why: A value is not bounded by the reader, so a large one must neither
# hang apply nor come out different from a short one. Bound: 60 s, against
# about 3 s measured for a 1 MiB value in the test-tools image -- the
# margin is for a loaded CI runner, not for a slower algorithm. The bound
# is ENFORCED: apply runs under `timeout`, which kills it at 60 s and
# answers 124, so a hang fails the status check instead of hanging the
# suite. And each run's value is asserted present in .env, whole, before
# the two generated sets are compared -- a comparison alone passes an
# emitter that drops the entry from both runs.
@test "a 1 MiB value finishes within 60 s and generates what a short value does" {
  local _short="abcdefgh"
  printf '[environment]\nenv_1 = "GREETING=%s"\n' "${_short}" > "${CONF}"
  _apply
  assert_success
  run grep -cxF "GREETING='${_short}'" "${REPO}/.env"
  assert_output "1"
  local _short_view
  _short_view="$(_generated_view "${REPO}")"
  _clear_generated

  local _big
  _big="$(head -c 1048576 /dev/zero | tr '\0' a)"
  printf '[environment]\nenv_1 = "GREETING=%s"\n' "${_big}" > "${CONF}"
  run --separate-stderr timeout --kill-after=5 60 bash -c "
    export LOG_FORMAT=json
    source '${SETUP_SH}'
    main apply --base-path '${REPO}'
  "
  (( status != 124 && status != 137 )) \
    || fail "apply on a 1 MiB value was killed at the 60 s bound (status ${status})"
  assert_success
  # The expected line goes to grep as a pattern FILE: one 1 MiB argv
  # string is past the kernel's per-argument limit (MAX_ARG_STRLEN).
  printf "GREETING='%s'\n" "${_big}" > "${TEMP_DIR}/big.line"
  run grep -cxF -f "${TEMP_DIR}/big.line" "${REPO}/.env"
  assert_output "1"
  local _big_view
  _big_view="$(_generated_view "${REPO}")"
  assert_equal "${_big_view//"${_big}"/"${_short}"}" "${_short_view}"
}

# why: A layer that is there and cannot be read is not an absent layer: a
# configuration replaced by the template defaults is the failure this must
# not become. Unreadability needs a user the mode applies to, so as root
# the case drops to `nobody` with su; without su it cannot be staged.
@test "an unreadable layer is refused with its status, event id and path" {
  printf '[network]\nmode = "host"\n' > "${CONF}"
  chmod 000 "${CONF}"
  chmod 777 "${REPO}"
  chmod 755 "${TEMP_DIR}"
  local _cmd="export LOG_FORMAT=json; source '${SETUP_SH}'; main apply --base-path '${REPO}'"
  if (( EUID == 0 )); then
    command -v su > /dev/null \
      || skip "running as root with no su: a mode-000 file is readable to root, so unreadability cannot be staged"
    run --separate-stderr su -s /bin/bash nobody -c "${_cmd}"
  else
    run --separate-stderr bash -c "${_cmd}"
  fi
  assert_refusal 1 conf_toml_merge_failed "${CONF}"
  _assert_nothing_generated
}

# why: A directory where setup.toml should be is not an absent layer
# either. Measured before base#1400: apply logged conf_no_repo_conf ("using
# template defaults"), then conf_upsert_file_missing writing the workspace
# bind into it, and exited 0 with compose.yaml generated. It must be
# refused like any other layer that is there and cannot be read.
@test "a directory in place of setup.toml is refused with its event id and path" {
  mkdir "${CONF}"
  _apply
  assert_refusal 1 conf_toml_merge_failed "${CONF}"
  _assert_nothing_generated
}

# why: A FIFO where setup.toml should be is there too, and unlike a
# directory it does not fail on open: open(2) on a FIFO blocks until a
# writer arrives, so an `-e` gate that hands it to the bridge hangs apply
# forever instead of refusing (review round 3 of base#1400). The bound
# makes the hang a failure instead of a wedged suite.
@test "a FIFO in place of setup.toml is refused within a bound, with its event id and path" {
  mkfifo "${CONF}"
  run --separate-stderr timeout --kill-after=5 20 bash -c "
    export LOG_FORMAT=json
    source '${SETUP_SH}'
    main apply --base-path '${REPO}'
  "
  (( status != 124 && status != 137 )) \
    || fail "apply on a FIFO layer was killed at the 20 s bound (status ${status}): it blocked opening the FIFO"
  assert_refusal 1 conf_toml_merge_failed "${CONF}"
  _assert_nothing_generated
}
